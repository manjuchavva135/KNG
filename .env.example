# KNG configuration template. Copy to `.env` and fill in.
# Anything left blank falls back to a local model so the pipeline still runs.

# ── Sarvam (primary provider: LLM + ASR + OCR + translation) ────────────────────
SARVAM_API_KEY=

# ── LLM (entity extraction + grounded synopsis) ────────────────────────────────
LLM_PROVIDER=sarvam            # sarvam | anthropic
SARVAM_CHAT_MODEL=sarvam-105b  # sarvam-105b | sarvam-30b  ('sarvam-m' is DEPRECATED:
                               # the API 400s on it. 105b is the only one verified
                               # to return tool calls; 30b failed the same probe.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Embeddings (multilingual TE/HI/EN — Sarvam has no embeddings API) ───────────
EMBED_PROVIDER=local           # local | cohere
# bge-m3: multilingual, 8192-token context (e5-base silently truncates at 512)
LOCAL_EMBED_MODEL=BAAI/bge-m3
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# ── OCR (newspaper cuttings + scanned PDFs) ────────────────────────────────────
OCR_PROVIDER=sarvam            # sarvam | tesseract | none
SARVAM_OCR_MODEL=sarvam-vision

# ── ASR (press-meet videos) ────────────────────────────────────────────────────
ASR_PROVIDER=sarvam            # sarvam | whisper | none
SARVAM_ASR_MODEL=saarika:v2.5
WHISPER_MODEL=large-v3

# ── Translation ────────────────────────────────────────────────────────────────
TRANSLATE_PROVIDER=sarvam      # sarvam | none
SARVAM_TRANSLATE_MODEL=mayura:v1
TRANSLATE_TO_EN=true

# ── Rerank (optional) ──────────────────────────────────────────────────────────
RERANK_PROVIDER=none           # cohere | llm | none
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Stores (embedded + portable) ───────────────────────────────────────────────
LANCEDB_PATH=index/lancedb
GRAPH_PATH=index/graph
GRAPH_BACKEND=networkx         # networkx | neo4j
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Graph build (WP3) ──────────────────────────────────────────────────────────
# Extraction is API-bound, so concurrency shortens the paid run without using
# cluster CPU. LLM_TIMEOUT must stay well above the SDK's 60s default: a
# generation that outruns it fails the call.
LLM_CONCURRENCY=4
LLM_RETRIES=4
LLM_TIMEOUT=120
LLM_SEED=42

# Chunk selection — the cost gate. Skipped chunks stay searchable in LanceDB and
# their file keeps its Source node; they are only left out of the paid pass.
# Check the effect with `--stage graph --plan-only`, which makes no calls.
GRAPH_MIN_CHUNK_CHARS=150      # drop cover pages / slide titles
GRAPH_MAX_TAG_DENSITY=0.5      # drop table dumps (a DSC merit list is 598 chunks)
GRAPH_MAX_CHUNKS_PER_FILE=60   # 0 disables the cap

# Communities (Louvain, via networkx — no compiled dependency to install locally)
COMMUNITY_RESOLUTION=1.0
MIN_ENTITY_MENTIONS=1          # >1 drops entities seen fewer times than this

# ── Behaviour ──────────────────────────────────────────────────────────────────
ANSWER_LANGUAGE=auto           # auto | en | te | hi
DATA_ROOT=data
