  "ba186951952bb7fef60c5376976724d950426b23": {
   "entities": [
    {
     "name": "నియోజకవర్గంలో ఎవరైనా మైనింగ్‌ చేసుకున్నా, పరిశ్రమ ఏర్పాటు చేసినా, కప్పం కట్టనిదే ఏ ఒక్కరూ ఏ పని చేయలేని పరిస్థితి.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఎమ్మెల్యేకు ఇంత. సీఎంకు ఇంత. రాష్ట్రవ్యాప్తంగా దోచుకో తినుకో పంచుకో అన్న విధంగా మాఫియా పని చేస్తోంది.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "వారు చేస్తున్న మోడస్‌ ఆపరండీ",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఒక అబద్ధానికి రెక్కలు కడతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ప్రజల ఆశలతో చెలగాటం ఆడుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "వారికి సంబంధించిన ఎమ్మెల్యేలు, కార్యకర్తలను ఎలా వాడుకుంటారు అంటే.. వాలంటీర్లకు రూ.10 వేలు ఇస్తామని మోసం చేస్తారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "వారి ఎమ్మెల్యే అభ్యర్థులు ఇల్లిల్లూ తిరిగారు. మైక్‌లు పట్టుకుని ఊదరగొట్టారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఆ ఇంట్లో చిన్న పిల్లలు కనిపిస్తే నీకు రూ.15 వేలు అని చెప్పి సంతోషమా? అని అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఆ చిన్న పిల్లల అమ్మలు కనబడితే నీకు రూ.18 వేలు సంతోషమా? అని అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఆ చిన్నపిల్లల చిన్నమ్మ కనబడినా అదే అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఆ చిన్న పిల్లల పెద్దమ్మలు లేదా ఆ తల్లి అత్త కనిపిస్తే నీకు రూ.48 వేలు సంతోషమా? అని అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "ఉద్యోగం కోసం వెతుక్కుంటూ పిల్లవాడు కనిపిస్తే, నీకు రూ.36 వేలు సంతోషమా? అని అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మెడలో కండువా వేసుకుని రైతు బయటకు వస్తే నీకు రూ.20 వేలు సంతోషమా? అని అడుగుతారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "అధికారంలోకి వచ్చిన తర్వాత..",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "రాష్ట్రం క్లిష్ట పరిస్థితిలో ఉంది.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "నేను చేయలేకపోతున్నానని చెప్పడం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "వారిని భయభ్రాంతులకు గురి చేయడం, అడిగే స్వరాలను మాట్లాడకుండా చేయాలని ఆరాటపడడం..",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మేము మారుస్తున్నాం. మార్పులు తీసుకొస్తున్నాం అని మార్పులు తీసుకొచ్చే క్రమంలో మార్పుల పేర్లు చెబుతూ, స్కామ్‌లకు తెర లేపుతున్నారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "అందులో భాగంగా వారు చేస్తున్న అవినీతి కార్యక్రమాల గురించి కొన్ని ఉదాహరణలు వివరిస్తాను.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "అవినీతి వ్యవహారం–ఇసుక",
