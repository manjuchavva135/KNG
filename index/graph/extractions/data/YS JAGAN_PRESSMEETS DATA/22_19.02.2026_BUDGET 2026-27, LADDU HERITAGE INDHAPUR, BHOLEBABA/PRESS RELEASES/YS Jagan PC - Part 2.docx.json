  "3cc473ff2066701db7ea152f7f8407ea5fa3308f": {
   "entities": [
    {
     "name": "మాకున్న లెక్కల ప్రకారం కేవలం రూ.200 కోట్లు ఖర్చు చేశారని, మిగతా ఫండ్స్‌ అన్నీ డైవర్ట్‌ చేశారని.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "రివైజ్డ్‌ ఎస్టిమేట్స్‌ లో రూ.1928 కోట్లు చూపిస్తున్నారు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "వైయస్సార్‌ సీపీ హయాంలో ఇళ్లపట్టాల కోసం, భూముల కొనుగోలు కోసం ఏకంగా రూ.11,871 కోట్లు మేం ఖర్చు చేస్తే ఇళ్ల నిర్మాణ కార్యక్రమం కోసం ఏకంగా 20,338 కోట్లు ఖర్చు చేశాం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "జగనన్న కాలనీల్లో మౌలిక సదుపాయాల కోసం మరో రూ.3 వేల కోట్లు ఖర్చు చేశాం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మొత్తంగా రూ.35,210 కోట్లు మేం అక్కచెల్లెమ్మల పేరిట ఇంటి స్థలాలు ఇవ్వడమే కాక వారికి ఇళ్లు కట్టించే కార్యక్రమంలో వారిని లక్షాధికారులను చేసే కార్యక్రమంలో అడుగులు వేశాం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "2024–25లో రూ.4 వేల కోట్లు ఖర్చు చేస్తామని కేవలం రూ.1548 కోట్లు, 2025–26లో రూ.6,300 కోట్లు ఖర్చు చేస్తామని చెప్పి రివైజ్డ్‌ ఎస్టిమేట్‌ లోనే రూ.1928 కోట్లు అని దారుణమైన నంబర్లు చూపించిన పరిస్థితి.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "కేంద్ర ప్రభుత్వం లోక్‌ సభకు డిసెంబర్‌ 12, 2024న ఇచ్చిన ఆన్సర్‌.. ఆంధ్రప్రదేశ్‌లో 5 సంవత్సరాల పీరియడ్‌కు సంబంధించి పీఎంఏవైయూ కింద వాళ్లు ఇచ్చినది.. ఏపీకి 21,37,028 ఇళ్లు శాంక్షన్‌ చేస్తే 10,02,729 పూర్తయిపోయాయని లెక్కలు చూపిస్తూ ఇచ్చిన డేటా.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "పొదుపు సంఘాల పరపతి తగ్గింది:",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మా హయాంలో ఇలా పొదుపు సంఘాలకు ఇచ్చే క్రెడిట్‌ లింకేజీ పెరుగుతూ పోతే.. 2023–24కు వచ్చే సరికే రూ.49,626 కోట్లకు బ్యాంకుల ద్వారా పొదుపు సంఘాలకు ఇచ్చే రుణాలు పోతే, చంద్రబాబు హయాంలో తగ్గుతూ తగ్గుతూ ఏకంగా 2025–26లో ఈ 10 నెలలకు సంబంధించి, గత డిసెంబరు 31 నాటికి చూస్తే అది రూ.30 వేల కోట్లకు పడిపోయింది. అది అంతకు ముందు ఏడాది రూ.41 వేల కోట్లు. అంటే మా ప్రభుత్వ హయాంలో రూ.49,626 కోట్లు ఉంటే, అది ఇప్పుడు చాలా తగ్గింది.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "నాడు–నేడు పనులు. నిధులు:",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "గవర్నమెంట్‌ స్కూల్స్, గవర్నమెంట్‌ హాస్పిటల్స్‌ ఈ రెండింటిలో కూడా నాడునేడు కార్యక్రమం దేశంలోనే రాష్ట్రానికి మంచిపేరును మేం తీసుకొచ్చి పెడితే అలాంటి గొప్ప కార్యక్రమాన్ని చంద్రబాబు తన చేతులతో ఉరివేశాడు.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మొదటి విడతలో మేం 15,713 స్కూళ్లలో నాడు–నేడు పనులు చేశాం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "రెండో విడతలో 22,312 స్కూళ్లలో దాదాపుగా పూర్తయ్యే దశకు తీసుకొచ్చాం.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మా ప్రభుత్వ హయాంలోనే రూ.8,524 కోట్లు ఖర్చు చేశామని చెప్పి ఈ చంద్రబాబుగారి ప్రభుత్వమే మొన్న అసెంబ్లీలో సమాధానం కూడా ఇచ్చింది.",
     "type": "Claim",
     "english_name": ""
    },
    {
     "name": "మరో రూ.4 వేల కోట్ల నుంచి రూ.5 వేల కోట్లు ఖర్చు చేస్తే నాడు–నేడు పనులన్నీ అయిపోతాయి.",
